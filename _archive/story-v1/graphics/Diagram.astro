---
// Final state: three clean steps. The .extra boxes and lines are the mess that scroll removes.
const extras = [
  [20, 24, 72, 28], [120, 56, 84, 28], [262, 18, 92, 28], [382, 64, 76, 28],
  [52, 246, 84, 28], [196, 256, 72, 28], [330, 240, 92, 28], [156, 96, 52, 24], [300, 104, 64, 24],
];
const tangles = [
  'M56 52 C 120 120, 200 40, 240 160', 'M162 84 C 260 120, 120 220, 90 246',
  'M308 46 C 330 120, 200 200, 232 256', 'M420 92 C 380 200, 160 120, 96 160',
  'M182 120 C 260 60, 330 300, 376 240', 'M332 128 C 300 200, 420 200, 400 160',
  'M94 260 C 200 300, 300 210, 376 254',
];
const core = [40, 190, 340];
---
<svg class="g-diagram" viewBox="0 0 480 320" aria-hidden="true" focusable="false">
  <defs>
    <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" fill="currentColor" />
    </marker>
  </defs>
  <g class="mess">
    {tangles.map((d) => <path class="extra tangle" d={d} />)}
    {extras.map(([x, y, w, h]) => <rect class="extra box" x={x} y={y} width={w} height={h} rx="4" />)}
  </g>
  <g class="clean">
    {core.map((x) => <rect class="step" x={x} y="140" width="100" height="40" rx="6" />)}
    <line class="link" x1="140" y1="160" x2="186" y2="160" marker-end="url(#arrow)" />
    <line class="link" x1="290" y1="160" x2="336" y2="160" marker-end="url(#arrow)" />
  </g>
</svg>

<style>
  .g-diagram { width: 100%; }
  .box { fill: none; stroke: var(--fg-dim); stroke-width: 1.2; }
  .tangle { fill: none; stroke: var(--fg-dim); stroke-width: 1; }
  .step { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .link { stroke: currentColor; stroke-width: 1.6; }
  /* Final state with no JS: the mess is already gone. */
  .extra { opacity: 0; }
</style>
