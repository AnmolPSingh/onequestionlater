---
// Five gig posters fanned like a hand of cards around a pivot below them.
const angles = [-28, -14, 0, 14, 28];
---
<svg class="g-posters" viewBox="0 0 480 360" aria-hidden="true" focusable="false">
  {angles.map((a, i) => (
    <g class="poster" data-angle={a} transform={`rotate(${a} 240 330)`}>
      <rect class="sheet" x="180" y="70" width="120" height="170" rx="3" />
      <rect class="block" x="194" y="86" width="92" height="64" />
      <circle class="dot" cx={i % 2 ? 222 : 258} cy="118" r="18" />
      <rect class="line" x="194" y="164" width="80" height="8" />
      <rect class="line" x="194" y="180" width="56" height="6" />
      <rect class="line" x="194" y="216" width="40" height="10" />
    </g>
  ))}
</svg>

<style>
  .g-posters { width: 100%; }
  .sheet { fill: var(--emerald); stroke: var(--fg); stroke-width: 1.2; }
  .block { fill: var(--fg); opacity: 0.12; }
  .dot { fill: currentColor; }
  .line { fill: var(--fg); opacity: 0.45; }
</style>
