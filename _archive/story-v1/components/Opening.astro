    <button type="button" data-sound-choice="on">Sound on</button>
    <button type="button" data-sound-choice="off">Sound off</button>
  </div>
  <p class="scroll-cue label">Scroll. It's a story, not a CV.</p>
  <p class="skip-short"><a href="/short-version">In a hurry? Read the short version.</a></p>
</section>
