---
import Base from '../layouts/Base.astro';
import Session from '../components/Session.astro';
import Work from '../components/Work.astro';
import Loader from '../components/Loader.astro';
import Footer from '../components/Footer.astro';
---
<Base noFooter>
  <Loader />
  <img class="ghost" data-ghost src="/hero/desert-soft.webp" alt="" aria-hidden="true" loading="lazy" />
  <main id="main">
    <section class="hero" data-shape="portrait" aria-labelledby="name">
      <h1 id="name" class="name">Anmol Pratap Singh</h1>
      <figure class="portrait" data-portrait>
        <img src="/hero/portrait.webp" srcset="/hero/portrait-760.webp 760w, /hero/portrait-1100.webp 1100w, /hero/portrait.webp 1600w" sizes="min(213vw, 123vh)" loading="lazy" alt="Anmol's head and shoulders, with curly hair and a short beard, drawn in points of light." width="1600" height="1206" />
      </figure>
      <p class="role">AI product builder</p>
      <span class="scroll-hint" aria-hidden="true"></span>
    </section>

    <section class="statement" data-shape="portrait">
      <div class="statement-pin">
        <p class="statement-big" data-spot>I build AI tools and automations for mission-driven organisations, the kind of work that usually needs a technical team but doesn't have to.</p>
        <h2 class="approach-h">Bring another way of seeing, then make it work</h2>
        <p class="approach">I start with the people doing the work. They bring knowledge of their field, its constraints, and the details that matter. I bring experience connecting people, information, decisions, and technology.</p>
      </div>
    </section>

    <Work />

    <Session />

    <section class="close" data-shape="desert" aria-labelledby="close-h" data-close>
      <div class="close-pin">
        <figure class="desert">
          <img src="/hero/desert.webp" alt="Me walking across a desert dune, looking back over my shoulder, drawn in points of light." loading="lazy" width="1600" height="1000" />
        </figure>
        <p class="close-lead" data-close-lead><span>Still no signal.</span><span>Still not stopping.</span></p>
        <div class="close-white" data-white></div>
        <div class="close-end">
          <h2 id="close-h" class="close-title" data-close-title>Let's keep turning the dial.</h2>
          <div id="contact" class="close-details" data-close-details>
            <Footer />
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/main.js';
</script>
