---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Named from '../../components/Named.astro';
import IsoFigure from '../../components/IsoFigure.astro';
import { SITE_NAME } from '../../config';
import { RELEASES, type Release } from '../../data/work';

export function getStaticPaths() {
  return RELEASES.map((release) => ({ params: { slug: release.slug }, props: { release } }));
}

const { release } = Astro.props as { release: Release };
const pages = import.meta.glob<{ Content: any }>('../../content/work/*.md');
const { Content } = await pages[`../../content/work/${release.slug}.md`]();
const index = RELEASES.indexOf(release);
const next = RELEASES[(index + 1) % RELEASES.length];
const extra = (release.sites ?? []).filter((site) => site.image !== release.cover); // the rest of what it made, laid beside the cover
---
<Base title={`${release.title} | ${SITE_NAME}`} description={release.summary}>
  <main id="main" class="plain-main release" data-read>
    <p class="kicker label">{[release.group, release.year].filter(Boolean).join(', ')}</p>
    <h1>{release.title}</h1>
    {release.kind && <p class="kicker">{release.kind}</p>}
    <p class="summary"><Named text={release.summary} /></p>
    {release.media?.map((m) => (
      <figure class="film">
        <video controls preload="none" playsinline poster={m.poster} aria-label={m.title}>
          <source src={`${m.src}.webm`} type="video/webm" />
          <source src={`${m.src}.mp4`} type="video/mp4" />
          {m.captions && <track kind="captions" src={m.captions} srclang="en" label="English" default />}
        </video>
        <figcaption class="label">{m.title}</figcaption>
      </figure>
    ))}
    {release.video ? (
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${release.video.id}?rel=0`} title={release.video.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    ) : release.loop && release.cover ? (
      <video class="loop" autoplay muted loop playsinline poster={release.cover.src} aria-label={release.coverAlt} data-loop>
        <source src={`${release.loop}.webm`} type="video/webm" />
        <source src={`${release.loop}.mp4`} type="video/mp4" />
      </video>
    ) : release.cover && (extra.length ? (
      <div class="cluster">
        <Image src={release.cover} alt={release.coverAlt!} widths={[640, 1200]} sizes="(min-width: 700px) 30rem, 92vw" loading="eager" />
        {extra.map((site) => <Image src={site.image} alt={site.alt} widths={[480, 900]} sizes="(min-width: 700px) 18rem, 92vw" loading="lazy" />)}
      </div>
    ) : (
      <Image src={release.cover} alt={release.coverAlt!} widths={[640, 1200]} sizes="(min-width: 700px) 42rem, 92vw" loading="eager" />
    ))}
    {release.figure && <IsoFigure class="system" name={release.figure} />}
    {release.figure && release.flow && (
      <ol class="flow-steps label" aria-hidden="true">
        {release.flow.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}
      </ol>
    )}
    {(release.figure || release.diagram) && <IsoFigure class="architecture-figure" name={`${release.slug}-architecture`} />}
    {release.video && release.cover && <Image src={release.cover} alt={release.coverAlt!} widths={[640, 1200]} sizes="(min-width: 700px) 42rem, 92vw" loading="lazy" />}
    {release.stats && (
      <dl class="stats">
        {release.stats.map(([value, label]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    )}
    <Content />
    {release.links && (
      <ul class="release-links">
        {release.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    )}
    <p class="back label"><a href="/#work">All work</a> &nbsp; <a href={`/work/${next.slug}`}>Next: {next.title}</a></p>
  </main>
</Base>

<script>
  import '../../scripts/ambient.js';
  // Reduced motion: loops stay on their poster frame.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLVideoElement>('[data-loop]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  // On a phone the architecture diagram scrolls sideways: start it at its first box, not the frame's empty margin,
  // and fade the right edge while there's more to see.
  const arch = document.querySelector<HTMLElement>('.architecture-figure');
  const plan = arch?.querySelector<SVGSVGElement>('svg');
  if (arch && plan && arch.scrollWidth > arch.clientWidth + 1) {
    const scale = plan.clientWidth / plan.viewBox.baseVal.width;
    arch.scrollLeft = Math.max(0, plan.getBBox().x * scale - 12);
    const more = () => arch.classList.toggle('more', arch.scrollLeft + arch.clientWidth < arch.scrollWidth - 4);
    arch.addEventListener('scroll', more, { passive: true });
    more();
  }
</script>
