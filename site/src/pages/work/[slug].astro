---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Named from '../../components/Named.astro';
import { SITE_NAME } from '../../config';
import { RELEASES, type Release } from '../../data/work';

export function getStaticPaths() {
  return RELEASES.map((release) => ({ params: { slug: release.slug }, props: { release } }));
}

const { release } = Astro.props as { release: Release };
const pages = import.meta.glob<{ Content: any }>('../../content/work/*.md');
const { Content } = await pages[`../../content/work/${release.slug}.md`]();
const index = RELEASES.indexOf(release);
const next = RELEASES[(index + 1) % RELEASES.length];
const extra = (release.sites ?? []).filter((site) => site.image !== release.cover); // the rest of what it made, laid beside the cover
---
<Base title={`${release.title} | ${SITE_NAME}`} description={release.summary}>
  <main id="main" class="plain-main release">
    <p class="kicker label">{[release.group, release.year].filter(Boolean).join(', ')}</p>
    <h1>{release.title}</h1>
    {release.kind && <p class="kicker">{release.kind}</p>}
    <p class="summary"><Named text={release.summary} /></p>
    {extra.length ? (
      <div class="cluster">
        <Image src={release.cover} alt={release.coverAlt} widths={[640, 1200]} sizes="(min-width: 700px) 30rem, 92vw" loading="eager" />
        {extra.map((site) => <Image src={site.image} alt={site.alt} widths={[480, 900]} sizes="(min-width: 700px) 18rem, 92vw" loading="lazy" />)}
      </div>
    ) : (
      <Image src={release.cover} alt={release.coverAlt} widths={[640, 1200]} sizes="(min-width: 700px) 42rem, 92vw" loading="eager" />
    )}
    {release.system && <Image class="system" src={release.system.image} alt={release.system.alt} loading="lazy" decoding="async" />}
    {release.stats && (
      <dl class="stats">
        {release.stats.map(([value, label]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    )}
    <Content />
    {release.links && (
      <ul class="release-links">
        {release.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    )}
    <p class="back label"><a href="/#work">All work</a> &nbsp; <a href={`/work/${next.slug}`}>Next: {next.title}</a></p>
  </main>
</Base>

<script>
  import '../../scripts/ambient.js';
</script>
