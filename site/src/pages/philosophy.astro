---
// The philosophy as a journey: the page pins, and scrolling carries one particle cloud through twelve
// formations, each meaning something for the words beside it. The words are Anmol's, unchanged. With no
// motion (or no JS) the beats simply stack, one after another, and read in order.
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../config';
import { FOUND, LEFT_BEHIND, JOINS, LOOP } from '../data/philosophy';
import '../styles/philosophy.css';

const BEATS = 12;
const n = (i: number) => `${String(i).padStart(2, '0')} / ${BEATS}`;
---
<Base title={`The philosophy | ${SITE_NAME}`} description="I follow questions. That's the only plan. Until they open unexpected doors." noFooter>
  <main id="main" class="journey" style={`--beats:${BEATS}`} data-journey>
    <div class="journey-stage">

      <section class="beat" data-shape="galaxy" data-count={n(1)}>
        <h1 class="beat-label label">ONE QUESTION LATER</h1>
        <p class="beat-key">I follow questions.</p>
        <p class="beat-line">That's the only plan.</p>
        <p class="beat-line">Until they open unexpected doors.</p>
      </section>

      <section class="beat" data-shape="found" data-count={n(2)}>
        <p class="beat-quiet">I never really decided what I wanted to become.</p>
        <p class="beat-line">I just kept finding things I wanted to <span class="lit">understand.</span></p>
      </section>

      <section class="beat" data-shape="path" data-count={n(3)}>
        <ol class="beat-path" data-unfold>
          {FOUND.map((line, i) => <li class:list={{ lit: i === FOUND.length - 1 }}>{line}</li>)}
        </ol>
      </section>

      <section class="beat" data-shape="static" data-count={n(4)}>
        <p class="beat-line">From the outside, it can look like I changed direction a lot.</p>
      </section>

      <section class="beat" data-shape="signal" data-count={n(5)}>
        <p class="beat-line">I don't think I did.</p>
        <p class="beat-line">I just kept <span class="lit">following the next question.</span></p>
      </section>

      <section class="beat" data-shape="lessons" data-count={n(6)}>
        <h2 class="beat-key">One question later...</h2>
        <ol class="beat-list" data-unfold>
          {LEFT_BEHIND.map((line) => <li>{line}</li>)}
        </ol>
      </section>

      <section class="beat" data-shape="accumulated" data-count={n(7)}>
        <p class="beat-quiet">But none of these replaced what came before.</p>
        <h2 class="beat-key">They accumulated.</h2>
        <ul class="beat-list" data-unfold>
          {JOINS.map((line) => <li>{line}</li>)}
        </ul>
      </section>

      <section class="beat" data-shape="tunnel" data-count={n(8)}>
        <p class="beat-line">The doors don't close behind me.</p>
        <p class="beat-line">They lead to other doors.</p>
      </section>

      <section class="beat" data-shape="static" data-count={n(9)}>
        <p class="beat-quiet">Maybe that's why I've never been particularly comfortable defining myself by one discipline.</p>
        <ul class="beat-changes" data-unfold>
          <li>The title changes.</li>
          <li>The tools change.</li>
          <li>The questions change.</li>
        </ul>
      </section>

      <section class="beat" data-shape="constant" data-count={n(10)}>
        <p class="beat-key lit">The behaviour doesn't.</p>
      </section>

      <section class="beat" data-shape="loop" data-count={n(11)}>
        <ol class="beat-loop" data-unfold>
          {LOOP.map((line, i) => <li class:list={{ lit: i === LOOP.length - 1 }}>{line}</li>)}
        </ol>
      </section>

      <section class="beat beat-end" data-shape="mark" data-count={n(12)}>
        <h2 class="beat-label label">ONE QUESTION LATER...</h2>
        <p class="beat-line">I'm somewhere I hadn't planned to be.</p>
        <p class="beat-line">With something I didn't know how to make before.</p>
        <p class="beat-quiet">And usually...</p>
        <p class="beat-key lit">another question.</p>
        <p class="beat-line beat-gap">There isn't supposed to be a final chapter.</p>
        <p class="beat-line">There is only the next question.</p>
        <a class="beat-on" href="/#work" aria-label="Carry on, into the work"><span aria-hidden="true">&rarr;</span></a>
      </section>

      <p class="journey-count label" aria-hidden="true" data-count-out>01 / {BEATS}</p>
    </div>
  </main>
</Base>

<script>
  import '../scripts/philosophy.js';
</script>
