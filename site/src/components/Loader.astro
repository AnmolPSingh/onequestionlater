---
// The first thing on screen: a choice to come in with sound or without. Either one starts the
// particles gathering into the portrait. Shown once a visit, never with reduced motion or JS off.
---
<div class="loader" data-loader>
  <div class="loader-choice" role="group" aria-label="How to enter">
    <button type="button" class="label" data-enter="sound">Enter with sound</button>
    <button type="button" class="label" data-enter="silent">Enter without sound</button>
  </div>
</div>
