---
// "Ask about Anmol", in the hero: one terminal line that opens into a short conversation. The questions go
// to /api/chat (site/api/chat.js), which holds the key and the guardrails; nothing secret is in the page.
// It needs JS, so without it the line isn't shown at all.
const CALENDLY = 'https://calendly.com/anmol-philanthropel/let-s-talk';
// Three of these are shown at random, so a returning visitor meets different openings.
const suggestions = ['Radio, music, film, then AI. How?', 'What does Anmol actually build?', 'Could he help my team?', 'Why "One Question Later"?', "What's Penname?", 'Surprise me.'];
---
<div class="ask" data-ask hidden>
  <div class="ask-panel" data-ask-panel>
    <div class="ask-log" data-ask-log data-lenis-prevent aria-live="polite">
      <p class="ask-line ask-bot">Hi, I'm Anmol AI. I've read this site and Anmol's LinkedIn, so ask me anything about him. Fair warning: I might answer with a question.</p>
    </div>
    <ul class="ask-suggest" data-ask-suggest>
      {suggestions.map((s) => <li><button type="button" data-ask-try>{s}</button></li>)}
    </ul>
    <p class="ask-note label">I only know this site and his LinkedIn. For the rest, <a href={CALENDLY}>book a call</a>.</p>
  </div>
  <form class="ask-bar" data-ask-form aria-label="Ask Anmol AI">
    <span class="ask-prompt" aria-hidden="true">&gt;</span>
    <label class="visually-hidden" for="ask-input">Ask Anmol AI</label>
    <input id="ask-input" name="q" type="text" autocomplete="off" maxlength="500" placeholder="Ask Anmol AI" data-ask-input />
    <input class="ask-trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit" class="ask-send" aria-label="Send">&rarr;</button>
    <button type="button" class="ask-close" data-ask-close aria-label="Close the conversation" hidden>&times;</button>
  </form>
</div>

<script>
  const MAX_PER_SESSION = 20; // the server has its own limits; this just saves a visitor a wasted request
  const ALLOWED = /^(https:\/\/(www\.)?onequestionlater\.com|https:\/\/calendly\.com\/anmol-philanthropel|https:\/\/www\.linkedin\.com\/in\/anmolps|https:\/\/philanthropel\.com|mailto:anmol@philanthropel\.com)/;
  const root = document.querySelector('[data-ask]');
  if (root) {
    root.hidden = false;
    const form = root.querySelector('[data-ask-form]');
    const input = root.querySelector('[data-ask-input]');
    const log = root.querySelector('[data-ask-log]');
    const suggest = root.querySelector('[data-ask-suggest]');
    const close = root.querySelector('[data-ask-close]');
    const trap = root.querySelector('.ask-trap');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const history = [];
    let busy = false;
    const tries = [...suggest.querySelectorAll('li')];
    for (let i = tries.length; i > 3; i--) tries.splice(Math.floor(Math.random() * i), 1)[0].remove();

    const asked = () => { try { return Number(sessionStorage.getItem('ask-count')) || 0; } catch { return 0; } };
    const count = () => { try { sessionStorage.setItem('ask-count', String(asked() + 1)); } catch { /* private mode */ } };

    const open = () => { root.classList.add('open'); close.hidden = false; };
    const shut = () => { root.classList.remove('open'); close.hidden = true; input.blur(); };

    // Text and links only: the answer is never inserted as HTML, and only approved addresses become links.
    const render = (el, text) => {
      el.textContent = '';
      for (const part of text.split(/(https?:\/\/[^\s<>"']+|mailto:[^\s<>"']+)/g)) {
        if (!part) continue;
        const url = part.replace(/[.,;:!?)]+$/, '');
        if (ALLOWED.test(url)) {
          const a = document.createElement('a');
          a.href = url;
          a.textContent = url.replace(/^https:\/\/(www\.)?/, '').replace(/^mailto:/, '');
          if (!url.includes('onequestionlater.com')) { a.target = '_blank'; a.rel = 'noopener'; }
          el.append(a, part.slice(url.length));
        } else el.append(part);
      }
    };

    const line = (who, text) => {
      const p = document.createElement('p');
      p.className = `ask-line ask-${who}`;
      log.append(p);
      if (text) render(p, text);
      log.scrollTop = log.scrollHeight;
      return p;
    };

    // The answer types itself out, then settles into text with its links.
    const type = (p, text) => new Promise((done) => {
      if (calm) { render(p, text); done(); return; }
      let i = 0;
      const step = () => {
        i = Math.min(text.length, i + Math.max(1, Math.round(text.length / 90)));
        p.textContent = text.slice(0, i);
        log.scrollTop = log.scrollHeight;
        if (i < text.length) requestAnimationFrame(step);
        else { render(p, text); done(); }
      };
      step();
    });

    const send = async (question) => {
      const q = question.trim();
      if (!q || busy) return;
      open();
      suggest.hidden = true;
      line('you', q);
      input.value = '';
      if (asked() >= MAX_PER_SESSION) {
        line('bot', "That's a lot of questions, which Anmol would take as a compliment. Let's carry on in person: https://calendly.com/anmol-philanthropel/let-s-talk");
        return;
      }
      busy = true;
      form.classList.add('busy');
      const reply = line('bot thinking', '');
      history.push({ role: 'user', content: q });
      let text;
      try {
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history.slice(-10), website: trap.value }) });
        const data = await res.json().catch(() => ({}));
        text = data.reply || (res.status === 429 ? 'Too many curious people at once. Give me a minute, or skip the queue and book a call: https://calendly.com/anmol-philanthropel/let-s-talk' : "I've lost the signal for a moment. You can reach Anmol at anmol@philanthropel.com, or book a call: https://calendly.com/anmol-philanthropel/let-s-talk");
        if (data.reply) history.push({ role: 'assistant', content: data.reply });
        else history.pop();
        count();
      } catch (err) {
        console.warn('Ask: request failed', err);
        history.pop();
        text = "Still no signal on my end. You can reach Anmol at anmol@philanthropel.com.";
      }
      reply.classList.remove('thinking');
      await type(reply, text);
      busy = false;
      form.classList.remove('busy');
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    input.addEventListener('focus', open);
    root.querySelectorAll('[data-ask-try]').forEach((b) => b.addEventListener('click', () => send(b.textContent)));
    close.addEventListener('click', shut);
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
  }
</script>
