---
// "Ask about Anmol": a mic that floats at the bottom of every screen, saying "Talk to Anmol AI". A tap opens the
// voice agent alone (no typing line): it greets the visitor aloud at once (the clip is fetched ahead), then listens, with the bust turning into the
// dome behind it. When the talk ends, the typing line comes back. The questions go
// to /api/chat (site/api/chat.js), which holds the key and the guardrails; nothing secret is in the page.
// It needs JS, so without it neither the mic nor the box is shown. No suggested questions: the visitor leads.
// Voice, where the browser can record: the mic dictates into the line (site/api/transcribe.js), and the talk
// button is the voice agent: it listens, sends when the visitor pauses, answers aloud in Anmol's voice
// (site/api/speak.js), then listens again, until it's tapped off or hears nothing.
// Open, it's one box over the dimmed page: the greeting, the conversation, the prompt, then a foot.
---
<button type="button" class="ask-launch" data-ask-launch hidden>
  <span class="ask-launch-icon" aria-hidden="true"><i></i><i></i>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
  </span>
  <span class="ask-launch-label">Talk to Anmol AI</span>
</button>
<div class="ask-veil" data-ask-veil></div>
<div class="ask" data-ask role="dialog" aria-label="Anmol AI" hidden>
  <div class="ask-panel" data-ask-panel>
    <div class="ask-log" data-ask-log data-lenis-prevent aria-live="polite">
      <p class="ask-line ask-bot">Hey! I'm Anmol AI. How can I help you today?</p>
    </div>
    <p class="ask-status" data-ask-status aria-live="polite"></p>
  </div>
  <form class="ask-bar" data-ask-form aria-label="Ask Anmol AI">
    <span class="ask-prompt" aria-hidden="true">&gt;</span>
    <label class="visually-hidden" for="ask-input">Ask Anmol AI</label>
    <input id="ask-input" name="q" type="text" autocomplete="off" enterkeyhint="send" maxlength="500" placeholder="Ask Anmol AI" data-ask-input />
    <input class="ask-trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="button" class="ask-mic" data-ask-mic aria-label="Speak your question" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
    </button>
    <button type="button" class="ask-talk" data-ask-talk aria-label="Talk with Anmol AI" aria-pressed="false" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 10v4"/></svg>
    </button>
    <button type="submit" class="ask-send" aria-label="Send">&rarr;</button>
  </form>
  <div class="ask-foot">
    <button type="button" class="ask-clear" data-ask-clear aria-label="Start over">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M8 20h12M4.6 14.6l8.8-8.8a2 2 0 0 1 2.8 0l2 2a2 2 0 0 1 0 2.8L11 18H8z"/><path d="m9.2 10 4.8 4.8"/></svg>
    </button>
    <p class="ask-note">I keep chats for 90 days so I can follow up. Your contact details, only if you share them.</p>
    <button type="button" class="ask-close" data-ask-close aria-label="Close the conversation">&times;</button>
  </div>
</div>

<script>
  const MAX_PER_SESSION = 20; // the server has its own limits; this just saves a visitor a wasted request
  const ALLOWED = /^(https:\/\/(www\.)?onequestionlater\.com|https:\/\/calendly\.com\/anmol-philanthropel|https:\/\/www\.linkedin\.com\/in\/anmolps|https:\/\/philanthropel\.com|mailto:anmol@philanthropel\.com)/;
  const root = document.querySelector('[data-ask]');
  if (root) {
    root.hidden = false;
    const form = root.querySelector('[data-ask-form]');
    const input = root.querySelector('[data-ask-input]');
    const log = root.querySelector('[data-ask-log]');
    const close = root.querySelector('[data-ask-close]');
    const clear = root.querySelector('[data-ask-clear]');
    const veil = document.querySelector('[data-ask-veil]');
    const launch = document.querySelector('[data-ask-launch]');
    launch.hidden = false;
    const greeting = log.firstElementChild.cloneNode(true);
    const trap = root.querySelector('.ask-trap');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const history = [];
    let busy = false;
    // One id per conversation, so the server can remember it; "start over" begins a new one.
    const fresh = () => { const id = crypto.randomUUID(); try { sessionStorage.setItem('ask-conversation', id); } catch { /* private mode */ } return id; };
    let conversation = (() => { try { return sessionStorage.getItem('ask-conversation'); } catch { return null; } })() || fresh();
    // When the visitor goes quiet, the server sends Anmol the brief from this conversation, if it has one.
    // Closing the chat or the page counts as done; a hidden tab gets a few minutes to come back.
    const quiet = (leaving) => {
      if (!history.length || !navigator.sendBeacon) return;
      navigator.sendBeacon('/api/brief', JSON.stringify({ conversation, leaving }));
    };
    addEventListener('pagehide', () => quiet(true));
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') quiet(false); });

    // Voice. Hearing stops at a pause after speech, a second tap, or the cap; silence alone is never sent.
    const LOUD = 6; // peak wobble around the waveform's middle (128) that counts as speech; low, as noise suppression quietens voices
    const MAX_UNMETERED_MS = 12000; // if the meter can't run, a tap or this ends the recording instead of a pause
    const HINT_MS = 3500;
    const PAUSE_MS = 1200;
    const NO_SPEECH_MS = 8000;
    const MAX_LISTEN_MS = 30000;
    // The dome's ears: the spectrum in log-spaced bands across speech, each rising fast and falling slowly,
    // divided by a slowly fading peak so a quiet voice moves it as much as a loud one.
    const BANDS = 8;
    const LOW_HZ = 90;
    const HIGH_HZ = 5000;
    const ATTACK = 0.55;
    const RELEASE = 0.08;
    const PEAK_FADE = 0.995;
    const PEAK_FLOOR = 0.12;
    const mic = root.querySelector('[data-ask-mic]');
    const talk = root.querySelector('[data-ask-talk]');
    const status = root.querySelector('[data-ask-status]');
    const placeholder = input.placeholder;
    // What the agent is doing, in the typing line and, while it's voice only, in the line that replaces it.
    const prompt = (text) => { input.placeholder = text; status.textContent = text === placeholder ? '' : text; };
    let sound = null; // one AudioContext, woken by a tap, so phones let it play an answer that arrives later
    let recording = null; // { stop } while the mic is open
    let speaking = null; // { stop } while the voice is playing
    // Answers play while they're still arriving, through one <audio> the first tap unlocks; where the browser can't
    // stream MP3 they play once the whole clip is in.
    const STREAMS = Boolean(window.MediaSource?.isTypeSupported?.('audio/mpeg'));
    const SILENT = 'data:audio/wav;base64,UklGRqQAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YYAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==';
    const VOICE_WAIT_MS = 4000; // the answer's text waits this long at most for its voice, so they arrive together
    let voice = null;
    // The greeting's sound, fetched ahead of time (the CDN keeps it), so it plays the moment the mic is tapped.
    let hello = null;
    const fetchHello = () => (hello ||= fetch('/api/speak').then((r) => (r.ok ? r.arrayBuffer() : null)).catch(() => null));
    let talking = false; // the voice agent is on
    let meter = null; // hears the mic while listening and the answer while speaking, never sent to the speakers
    let wave;
    let spectrum;
    let edges;
    let peak = PEAK_FLOOR;
    const bands = new Float32Array(BANDS);

    const wake = () => {
      if (!sound) {
        sound = new AudioContext();
        meter = sound.createAnalyser();
        meter.fftSize = 1024;
        meter.smoothingTimeConstant = 0.5;
        wave = new Uint8Array(meter.fftSize);
        spectrum = new Uint8Array(meter.frequencyBinCount);
        const hz = sound.sampleRate / meter.fftSize;
        edges = Array.from({ length: BANDS + 1 }, (_, b) => Math.round((LOW_HZ * (HIGH_HZ / LOW_HZ) ** (b / BANDS)) / hz));
        for (let b = 1; b <= BANDS; b++) edges[b] = Math.max(edges[b], edges[b - 1] + 1);
        if (STREAMS) {
          voice = new Audio();
          const out = sound.createMediaElementSource(voice);
          out.connect(sound.destination);
          out.connect(meter); // the dome moves with the voice
          voice.src = SILENT; // played inside the tap, so later answers are allowed to play
          voice.play().catch(() => { /* fine: the stream will try again */ });
        }
      }
      sound.resume();
    };

    const hear = () => {
      meter.getByteFrequencyData(spectrum);
      const raw = [];
      for (let b = 0; b < BANDS; b++) {
        let sum = 0;
        for (let i = edges[b]; i < edges[b + 1]; i++) sum += spectrum[i];
        raw.push(sum / ((edges[b + 1] - edges[b]) * 255));
      }
      peak = Math.max(...raw, peak * PEAK_FADE, PEAK_FLOOR);
      raw.forEach((v, b) => {
        const target = Math.min(1, v / peak);
        bands[b] += (target - bands[b]) * (target > bands[b] ? ATTACK : RELEASE);
      });
      return bands;
    };

    // Says why nothing happened, in the line itself, then puts the usual prompt back.
    const hint = (text) => {
      prompt(text);
      setTimeout(() => { if (input.placeholder === text) prompt(placeholder); }, HINT_MS);
    };

    const listen = async () => {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
      await sound.resume(); // iPhones pause page audio when the mic opens; without this the meter hears only silence
      const rec = new MediaRecorder(stream);
      const chunks = [];
      rec.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
      const source = sound.createMediaStreamSource(stream);
      source.connect(meter);
      const started = performance.now();
      let heard = false;
      let metered = false; // whether the meter ever ran; if it never did, the clip is sent anyway rather than thrown away
      let quietSince = 0;
      const stopped = new Promise((done) => { rec.onstop = done; });
      const stop = () => { if (rec.state !== 'inactive') rec.stop(); };
      recording = { stop };
      root.classList.add('listening');
      prompt('Listening...');
      rec.start();
      const watch = () => {
        if (rec.state === 'inactive') return;
        const now = performance.now();
        if (sound.state !== 'running') {
          sound.resume();
          if (now - started > MAX_UNMETERED_MS) stop(); else requestAnimationFrame(watch);
          return;
        }
        metered = true;
        meter.getByteTimeDomainData(wave);
        let peak = 0;
        for (const v of wave) peak = Math.max(peak, Math.abs(v - 128));
        root.style.setProperty('--level', Math.min(1, peak / 48).toFixed(2)); // the mic's ring grows with the voice
        if (peak > LOUD) { heard = true; quietSince = 0; } else quietSince ||= now;
        const paused = heard && quietSince && now - quietSince > PAUSE_MS;
        if (paused || now - started > MAX_LISTEN_MS || (!heard && now - started > NO_SPEECH_MS)) stop();
        else requestAnimationFrame(watch);
      };
      watch();
      await stopped;
      stream.getTracks().forEach((t) => t.stop());
      source.disconnect();
      recording = null;
      root.classList.remove('listening');
      root.style.setProperty('--level', '0');
      prompt(placeholder);
      if (metered && !heard) { hint("I didn't catch that. Try again?"); return ''; }
      prompt('Thinking...');
      try {
        const type = (rec.mimeType || chunks[0]?.type || 'audio/mp4').split(';')[0];
        const res = await fetch('/api/transcribe', { method: 'POST', headers: { 'content-type': type }, body: new Blob(chunks, { type }) });
        const text = (await res.json().catch(() => ({}))).text || '';
        prompt(placeholder);
        if (!text) hint(res.ok ? "I didn't catch that. Try again?" : 'My ears are busy. Try again in a moment?');
        return text;
      } catch (err) {
        prompt(placeholder);
        throw err;
      }
    };

    // A whole clip, decoded then played: the greeting, and answers where streaming isn't supported.
    const playClip = async (buffer, begin) => {
      if (!buffer || !talking) return;
      const clip = sound.createBufferSource();
      clip.buffer = await sound.decodeAudioData(buffer.slice(0)); // a copy, so the greeting can play again
      if (!talking) return;
      clip.connect(sound.destination);
      clip.connect(meter);
      await new Promise((done) => {
        speaking = { stop: () => clip.stop() };
        clip.onended = done;
        clip.start();
        begin();
      });
    };

    // An answer that plays from its first chunk, as the server streams it.
    const playStream = async (body, begin) => {
      const source = new MediaSource();
      const url = URL.createObjectURL(source);
      voice.src = url;
      await new Promise((ready) => source.addEventListener('sourceopen', ready, { once: true }));
      const buffer = source.addSourceBuffer('audio/mpeg');
      try { buffer.mode = 'sequence'; } catch { /* the default works too */ }
      const append = (chunk) => new Promise((done) => { buffer.addEventListener('updateend', done, { once: true }); buffer.appendBuffer(chunk); });
      const reader = body.getReader();
      let finish;
      const finished = new Promise((done) => { finish = done; voice.onended = done; voice.onerror = done; });
      let stopped = false;
      speaking = { stop: () => { stopped = true; reader.cancel().catch(() => {}); voice.pause(); finish(); } };
      let started = false;
      for (;;) {
        const { done, value } = await reader.read();
        if (done || stopped) break;
        await append(value);
        if (!started) {
          started = true;
          voice.play().then(begin, (err) => { console.warn('Ask: the voice was not allowed to play', err); speaking.stop(); });
        }
      }
      if (!stopped && source.readyState === 'open') source.endOfStream();
      if (!started) finish();
      await finished;
      URL.revokeObjectURL(url);
    };

    // Speaks in Anmol's voice: a signed answer, or with no text the greeting. `started` settles when the first sound
    // plays (or it fails), `done` when it ends, stops or fails.
    const say = (text, signature) => {
      let begin;
      const started = new Promise((go) => { begin = go; });
      const done = (async () => {
        try {
          if (!text) { await playClip(await fetchHello(), begin); return; }
          const res = await fetch('/api/speak', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text, voice: signature }) });
          if (res.status !== 200 || !talking) return;
          if (voice && res.body) await playStream(res.body, begin);
          else await playClip(await res.arrayBuffer(), begin);
        } catch (err) {
          console.warn('Ask: could not speak', err);
        } finally { speaking = null; begin(); }
      })();
      return { started, done };
    };

    const endTalk = () => {
      if (talking) dispatchEvent(new CustomEvent('ask:talk', { detail: null })); // I come back from the dome
      talking = false;
      document.documentElement.classList.remove('talking');
      root.classList.remove('voice'); // the typing line comes back
      talk.setAttribute('aria-pressed', 'false');
      talk.setAttribute('aria-label', 'Talk with Anmol AI');
      recording?.stop();
      try { speaking?.stop(); } catch { /* already finished */ }
    };

    // The voice agent: listen, answer aloud, listen again. Silence, an error or a tap ends it.
    // From the floating mic it's voice only, and opens with the greeting said aloud.
    const startTalk = (voiceOnly = false) => {
      wake();
      talking = true;
      root.classList.toggle('voice', voiceOnly);
      document.documentElement.classList.add('talking');
      dispatchEvent(new CustomEvent('ask:talk', { detail: { bands: hear } })); // the bust becomes the dome
      talk.setAttribute('aria-pressed', 'true');
      talk.setAttribute('aria-label', 'Stop talking');
      open();
      converse(voiceOnly && !history.length);
    };

    const converse = async (greet) => {
      if (greet) await say().done;
      while (talking) {
        let words = '';
        try { words = await listen(); } catch (err) { console.warn('Ask: microphone unavailable', err); hint('I need the microphone for that.'); }
        if (!talking || !words) break;
        await send(words, 'voice');
      }
      endTalk();
    };

    const asked = () => { try { return Number(sessionStorage.getItem('ask-count')) || 0; } catch { return 0; } };
    const count = () => { try { sessionStorage.setItem('ask-count', String(asked() + 1)); } catch { /* private mode */ } };

    const open = () => { root.classList.add('open'); veil.classList.add('on'); launch.classList.add('away'); };
    const shut = () => {
      if (!root.classList.contains('open')) return;
      root.classList.remove('open'); veil.classList.remove('on'); launch.classList.remove('away');
      input.blur();
      launch.focus({ preventScroll: true });
    };

    // Text and links only: the answer is never inserted as HTML, and only approved addresses become links.
    const render = (el, text) => {
      el.textContent = '';
      for (const part of text.split(/(https?:\/\/[^\s<>"']+|mailto:[^\s<>"']+)/g)) {
        if (!part) continue;
        const url = part.replace(/[.,;:!?)]+$/, '');
        if (ALLOWED.test(url)) {
          const a = document.createElement('a');
          a.href = url;
          a.textContent = url.replace(/^https:\/\/(www\.)?/, '').replace(/^mailto:/, '');
          if (!url.includes('onequestionlater.com')) { a.target = '_blank'; a.rel = 'noopener'; }
          el.append(a, part.slice(url.length));
        } else el.append(part);
      }
    };

    const line = (who, text) => {
      const p = document.createElement('p');
      p.className = `ask-line ask-${who}`;
      log.append(p);
      if (text) render(p, text);
      log.scrollTop = log.scrollHeight;
      return p;
    };

    // The answer types itself out, then settles into text with its links.
    const type = (p, text) => new Promise((done) => {
      if (calm) { render(p, text); done(); return; }
      let i = 0;
      const step = () => {
        i = Math.min(text.length, i + Math.max(1, Math.round(text.length / 90)));
        p.textContent = text.slice(0, i);
        log.scrollTop = log.scrollHeight;
        if (i < text.length) requestAnimationFrame(step);
        else { render(p, text); done(); }
      };
      step();
    });

    const send = async (question, channel = 'text') => {
      const q = question.trim();
      if (!q || busy) return;
      open();
      line('you', q);
      input.value = '';
      if (asked() >= MAX_PER_SESSION) {
        line('bot', "That's a lot of questions, which I'll take as a compliment. Let's carry on in person: https://calendly.com/anmol-philanthropel/let-s-talk");
        return;
      }
      busy = true;
      form.classList.add('busy');
      const reply = line('bot thinking', '');
      history.push({ role: 'user', content: q });
      let text;
      let signature = null;
      try {
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history.slice(-10), website: trap.value, conversation, channel, page: location.pathname, referrer: document.referrer }) });
        const data = await res.json().catch(() => ({}));
        text = data.reply || (res.status === 429 ? 'Too many curious people at once. Give me a minute, or skip the queue and book a call with me: https://calendly.com/anmol-philanthropel/let-s-talk' : "I've lost the signal for a moment. Reach me at anmol@philanthropel.com, or book a call: https://calendly.com/anmol-philanthropel/let-s-talk");
        if (data.reply) { history.push({ role: 'assistant', content: data.reply }); signature = data.voice; }
        else history.pop();
        count();
      } catch (err) {
        console.warn('Ask: request failed', err);
        history.pop();
        text = "Still no signal on my end. You can reach me at anmol@philanthropel.com.";
      }
      const speech = talking && signature ? say(text, signature) : null;
      if (speech) await Promise.race([speech.started, new Promise((wait) => setTimeout(wait, VOICE_WAIT_MS))]); // the words appear as the voice starts
      reply.classList.remove('thinking');
      await type(reply, text);
      await speech?.done;
      busy = false;
      form.classList.remove('busy');
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    const canTalk = Boolean(navigator.mediaDevices?.getUserMedia && window.MediaRecorder && window.AudioContext);
    // The floating mic: talking starts at once; where the browser can't record, it opens the box to type in.
    if (canTalk) {
      // Fetched once the page has settled, or as soon as the mic is reached for, whichever comes first.
      if (document.readyState === 'complete') setTimeout(fetchHello, 1500);
      else addEventListener('load', () => setTimeout(fetchHello, 1500), { once: true });
      launch.addEventListener('pointerenter', fetchHello, { once: true });
      launch.addEventListener('focus', fetchHello, { once: true });
    }
    launch.addEventListener('click', () => {
      if (canTalk && !busy && !recording) startTalk(true);
      else { open(); input.focus(); }
    });
    // On phones it shrinks to just the mic once the hero has gone, so it never sits on the words.
    const hero = document.querySelector('.hero');
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => launch.classList.toggle('compact', !entry.isIntersecting), { threshold: 0.35 }).observe(hero);
    }
    if (canTalk) {
      mic.hidden = false;
      talk.hidden = false;
      // Dictation: the words land in the line, to edit or send. While talking, a tap just means "I'm done".
      mic.addEventListener('click', async () => {
        if (recording) { recording.stop(); return; }
        if (busy || talking) return;
        wake();
        try {
          const words = await listen();
          if (words) { input.value = words; input.focus(); }
        } catch (err) { console.warn('Ask: microphone unavailable', err); hint('I need the microphone for that.'); }
      });
      talk.addEventListener('click', () => {
        if (talking) { endTalk(); return; }
        if (busy || recording) return;
        startTalk();
      });
    }

    close.addEventListener('click', () => { endTalk(); shut(); quiet(true); });
    veil.addEventListener('click', () => { endTalk(); shut(); quiet(true); });
    clear.addEventListener('click', () => {
      if (busy) return;
      quiet(true);
      history.length = 0;
      conversation = fresh();
      log.replaceChildren(greeting.cloneNode(true));
      input.focus();
    });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape') { endTalk(); shut(); quiet(true); } });
  }
</script>
